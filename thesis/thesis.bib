@inproceedings{restle2000choosing,
	abstract = {FPGA, unlike a DSP, is a parallel device and its hardware is custom configured for the job at hand. FPGA have two main advantages over DSP chips when it comes to mathematical operations. First, they allow many different operations to be implemented on the same device meaning that the answers can be evaluated simultaneously. Second, buses are required to effectively carry data. Most DSP chips have several buses but an FPGA can contain hundreds, if not thousands of them. Furthermore, the width of each bus can be exactly the number of bits needed; i.e., precision is not lost and no extra memory is consumed. This makes FPGAs very cost effective. To sum up, math is fastest when implemented on FPGAs; since the algorithm and technology can be optimized to the flow of data},
	author = {Restle, Randall C},
	booktitle = {Conference proceedings of ICSPAT: DSP world, Autumn},
	title = {Choosing between DSPs, FPGAs, $\mu$Ps, and ASICs to implement digital signal processing},
	year = {2000}
}

@inproceedings{usenmez2009real,
	abstract = {This study focuses on the development an integrated software and hardware platform that is capable of performing real-time simulation of dynamic systems, including electrical machinery, for the purpose of hardware-in-the-loop simulation (HILS). The system to be controlled is first defined using a block diagram editor. The defined model is then compiled and downloaded onto an FPGA (?`Field Programmable Gate Array?`) based hardware platform, which is to interface with the controller under test and carry out the simulation in real-time. The full paper will elaborate the characteristics of this novel HILS platform.},
